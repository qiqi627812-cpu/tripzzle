# 百度语音 API 配置（生产环境在 Vercel 控制台设置）
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# OpenAI（仅服务端读取，不要使用 VITE_ 前缀）
OPENAI_API_KEY=your_openai_api_key_here
# 可选：面向高频旅行规划的低延迟模型
OPENAI_MODEL=gpt-5.6-luna

# 豆包 / 火山方舟
AI_PROVIDER=doubao
ARK_API_KEY=your_ark_api_key_here
ARK_MODEL=doubao-seed-2-0-lite-260428

# 注意：
# - 本地开发时，这些环境变量无效（Vite 前端无法读取）
# - 本地开发仍支持用户在设置面板手动输入 key（通过 corsproxy 代理）
# - 部署到 Vercel 后，在控制台 Settings → Environment Variables 中设置这两个变量
